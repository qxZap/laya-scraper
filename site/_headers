/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Frame-Options: DENY

/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' https://cdn.vibe-coding.fans; connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'

/404.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' https://cdn.vibe-coding.fans; connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'

/img/*
  Cache-Control: public, max-age=31536000, immutable

/explainer.mp4
  Cache-Control: public, max-age=604800

/style.css
  Cache-Control: public, max-age=3600

/app.js
  Cache-Control: public, max-age=3600
