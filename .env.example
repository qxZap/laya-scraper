# Copy to .env (git-ignored) and fill in ONE of the blocks below.
# The LLM is only used while a scraper is being built (plan, locate, map + validate selectors).
# Once a site's recipe exists in selectors/, runs make no LLM calls at all.

# ---------------------------------------------------------------------------
# A) OpenAI-compatible endpoint  (LLM_API=openai is the default)
#    POST {LLM_BASE_URL}/chat/completions
# ---------------------------------------------------------------------------

# MiniMax (default; get a key at https://www.minimax.io)
LLM_API=openai
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3
LLM_API_KEY=your-minimax-key
LLM_PRICE_IN=0.30          # USD per million input tokens, for the cost report
LLM_PRICE_OUT=1.20         # USD per million output tokens

# OpenAI
# LLM_API=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5-mini
# LLM_API_KEY=sk-...
# LLM_PRICE_IN=...          # your model's list price
# LLM_PRICE_OUT=...

# Local model, no key and no cost (Ollama / LM Studio / vLLM all speak this API)
# LLM_API=openai
# LLM_BASE_URL=http://localhost:11434/v1     # LM Studio: http://localhost:1234/v1
# LLM_MODEL=qwen3
# LLM_API_KEY=
# LLM_PRICE_IN=0
# LLM_PRICE_OUT=0

# ---------------------------------------------------------------------------
# B) Anthropic-compatible endpoint
#    POST {LLM_BASE_URL}/messages  with x-api-key + anthropic-version headers
# ---------------------------------------------------------------------------

# Anthropic (Claude)
# LLM_API=anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-sonnet-5
# LLM_API_KEY=sk-ant-...
# LLM_PRICE_IN=...          # your model's list price
# LLM_PRICE_OUT=...

# MiniMax through its Anthropic-compatible API (same key as block A)
# LLM_API=anthropic
# LLM_BASE_URL=https://api.minimax.io/anthropic/v1
# LLM_MODEL=MiniMax-M3
# LLM_API_KEY=your-minimax-key

# ---------------------------------------------------------------------------
# Politeness (optional)
# ---------------------------------------------------------------------------
# LLM_MIN_GAP=3            # seconds between LLM calls (shared plans have quotas)
# POLITE_DELAY=0.25        # seconds between plain HTTP requests to the same host
# IGNORE_ROBOTS=1          # only for sites you own or may crawl
# HEADLESS=1               # true headless browser (Cloudflare-challenged sites need the default off-screen window)
