{
  "selectors": {
    "posted_date": [
      "meta:article:published_time"
    ],
    "amount": [
      "re:(?i)Grant amount:\\s*([^\\n]+)",
      "article.post.type-post > div.entry-content > ul > li > strong || Czech financial contribution per project:"
    ],
    "summary": [
      "article.post.type-post > div.entry-content > p"
    ],
    "application_url": [
      "article.post.type-post > div.entry-content > ol > li > a || Read the official guidelines."
    ],
    "application_deadline": [
      "re:(?:Application close date|Deadline):\\s*(\\d{1,2} \\w+ \\d{4})",
      "article.post.type-post > div.entry-content > ul > li > strong || Deadline to apply:",
      "article.post.type-post > div.entry-content > ul > li > strong || Closing date:"
    ],
    "categories": [
      "ld:articleSection"
    ],
    "title": [
      "ld:headline",
      "article.post.type-post > header.entry-header > h1.entry-title"
    ],
    "eligibility": [
      "re:(?is)Who\\s+(?:it\\s+serves|Is\\s+Eligible)[:?]?\\s*(.+?)(?=\\n\\s*(?:Eligible|Why|How|About|Application|Selection))"
    ]
  },
  "fields": {
    "title": "validated (4/4 correct)",
    "funder": "unreliable ({'wrong': 2, 'correct': 2})",
    "summary": "validated (3/4 correct)",
    "amount": "validated as text pattern (1/4 correct)",
    "application_deadline": "validated (3/4 correct)",
    "posted_date": "validated (4/4 correct)",
    "eligibility": "validated as text pattern (3/4 correct)",
    "grant_id": "absent (not shown on sample pages)",
    "application_url": "validated (1/4 correct)",
    "categories": "validated (4/4 correct)"
  },
