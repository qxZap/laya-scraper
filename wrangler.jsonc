{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laya-scraper",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "laya.vibe-coding.fans", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
